{
  "permissions": {
    "allow": [
      "Bash(streamlit run *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8501)",
      "Bash(powershell -Command 'Get-Process python -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -like '\\\\''*streamlit*'\\\\'' -or $_.MainWindowTitle -like '\\\\''*streamlit*'\\\\'' } | Stop-Process -Force')",
      "Bash(taskkill /F /IM \"streamlit.exe\")",
      "Bash(taskkill /F /IM \"python.exe\" /FI \"WINDOWTITLE eq streamlit*\")",
      "Bash(git init *)",
      "Bash(git add *)"
    ]
  }
}
