# ── Golden Scanner — Secrets Template ──────────────────────────
# Copy this file to secrets.toml and fill in real values.
# secrets.toml is gitignored — never commit it.
# On Streamlit Cloud: Settings → Secrets → paste the [gsheets] block.

# ── App auth ────────────────────────────────────────────────────
APP_PASSWORD   = "your_login_password"   # main app login
ADMIN_PASSWORD = "your_admin_password"   # separate Admin Panel gate

# ── Google Sheets (persistent tracking + watchlist) ─────────────
# Follow setup guide in README or ask Claude.
# Required to avoid data loss on app restarts.
#
# Steps:
#   1. Create a Google Sheet named "GoldenScanner Tracking"
#   2. Enable Google Sheets API + Google Drive API in Google Cloud Console
#   3. Create a Service Account → download JSON key
#   4. Share the sheet (Editor access) with the service account's client_email
#   5. Fill in the fields below from the downloaded JSON key file

[gsheets]
type            = "service_account"
project_id      = "your-gcp-project-id"
private_key_id  = "abc123..."
# Important: keep the literal \n in the key — do NOT use real line breaks
private_key     = "-----BEGIN RSA PRIVATE KEY-----\nMIIE...(key body)...\n-----END RSA PRIVATE KEY-----\n"
client_email    = "golden-scanner-bot@your-project.iam.gserviceaccount.com"
client_id       = "123456789012345678901"
sheet_id        = "1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms"
